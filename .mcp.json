{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "shrimp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "if defined CLAUDE_PROJECT_DIR (set \"DATA_DIR=%CLAUDE_PROJECT_DIR%\\.shrimp\") else (set \"DATA_DIR=%CD%\\.shrimp\") && npx -y mcp-shrimp-task-manager"
      ],
      "env": {
        "DATA_DIR": "${CLAUDE_PROJECT_DIR:-.}/.shrimp",
        "TEMPLATES_USE": "en",
        "ENABLE_GUI": "false"
      }
    },
    "structurizr": {
      "type": "http",
      "url": "https://mcp.structurizr.com/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp?login"
    },
    "mlflow": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "mlflow[mcp]>=3.5", "mlflow", "mcp", "run"],
      "env": {
        "MLFLOW_TRACKING_URI": "${MLFLOW_TRACKING_URI:-http://127.0.0.1:5000}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}"
      ]
    }
  }
}
